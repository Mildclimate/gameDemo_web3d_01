{
  "name": "astra-lost-relic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASTRA: Lost Relic - Web 3D exploration demo built with Vue 3, TypeScript and Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
